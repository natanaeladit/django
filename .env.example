# Copy to .env for local development. Never commit .env.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-me-with-a-generated-key-of-at-least-50-characters
# 127.0.0.1, not localhost: on Windows localhost resolves to IPv6 first and Docker listens on IPv4.
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# TLS terminates at the load balancer in production; there is none locally.
SECURE_SSL_REDIRECT=false
LOG_LEVEL=INFO
